  "structural": [
    {
      "id": "not-just-but",
      "name": "\"It's not just X, it's Y\"",
      "pattern": "\\b((it|this|that|they|we|you)('s|'re|\\s+is|\\s+are|\\s+was|\\s+were)\\s+not|isn'?t|aren'?t|wasn'?t|weren'?t)\\s+(just|only|merely|simply)\\b[^.!?\\n]{1,80}?[,;:\\u2014-]\\s*(it'?s|it is|this is|that'?s|they'?re|we'?re|but|it was)\\b",
      "min_count": 1,
      "why": "The most recognisable generated-text construction.",
      "fix": "Say the one thing it is."
    },
    {
      "id": "not-only-but-also",
      "name": "\"Not only X but also Y\"",
      "pattern": "\\bnot only\\b[^.!?\\n]{1,100}?\\bbut\\b",
      "min_count": 1,
      "why": "Essay scaffolding; nobody talks like this on X.",
      "fix": "Split into two plain sentences, or keep the stronger half."
    },
    {
      "id": "rule-of-three",
      "name": "Rule-of-three overuse",
      "pattern": "\\b[\\w'-]+,\\s+[\\w'-]+,?\\s+and\\s+[\\w'-]+\\b",
      "min_count": 2,
      "why": "One triad is rhythm. Two or more in a short post is a pattern.",
      "fix": "Cut each list to the one or two items that matter."
    },
    {
      "id": "em-dash-overuse",
      "name": "Em dash overuse",
      "pattern": "\\u2014",
      "min_count": 2,
      "why": "Heavy em dash use is a common tell in generated text.",
      "fix": "Use a period, a comma, or a colon. humanize.py converts them."
    },
    {
      "id": "rhetorical-reveal",
      "name": "One-word rhetorical question",
      "pattern": "(^|[.!?]\\s+)(the (result|answer|catch|twist|kicker|best part|problem|secret|truth|reason|outcome)|what happened( next)?)\\s*\\?(\\s|$)",
      "min_count": 1,
      "why": "\"The result?\" is a staged reveal.",
      "fix": "State the result directly."
    },
    {
      "id": "staged-colon",
      "name": "Staged colon reveal",
      "pattern": "\\b(here'?s the (thing|kicker|catch|deal|truth|secret|twist)|plot twist|spoiler( alert)?|the kicker)\\s*[:.]",
      "min_count": 1,
      "why": "A drumroll before the point.",
      "fix": "Delete the setup and start with the point."
    },
    {
      "id": "emoji-bullets",
      "name": "Emoji bullet list",
      "pattern": "^\\s*[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF]\\uFE0F?\\s*\\S",
      "min_count": 3,
      "why": "Three or more lines that start with an emoji read as a template.",
      "fix": "Use plain line breaks or numbers."
    },
    {
      "id": "hashtag-wall",
      "name": "Hashtag wall",
      "pattern": "(?:#\\w+\\s*){3,}",
      "min_count": 1,
      "why": "Three or more hashtags in a row reads as spam on X.",
      "fix": "Keep one hashtag at most, or none."
    },
    {
      "id": "engagement-bait",
      "name": "Engagement bait",
      "pattern": "\\b(like|rt|repost|retweet|share|comment|reply)\\s+(this\\s+)?if\\b|\\bfollow (me )?for (more|part)\\b|\\btag (someone|a friend|\\d+ friends)\\b|\\bcomment ['\"]?\\w+['\"]? (below|and i'?ll)\\b|\\bdrop an? \\S+ (below|in the comments)\\b",
      "min_count": 1,
      "why": "Asks for engagement instead of earning it.",
      "fix": "Ask one real question, or end without an ask."
    },
    {
      "id": "shouting",
      "name": "Three or more shouted words",
      "pattern": "\\b[A-Z]{3,}(?:\\W+[A-Z]{3,}){2,}\\b",
      "case_sensitive": true,
      "min_count": 1,
      "why": "All-caps runs read as hype.",
      "fix": "Write it in normal case; keep one stressed word at most."
    },
